{
    "include": ["app"],
    "exclude": ["**/node_modules/**", "**/__pycache__/**", "**/.*", ".venv"],
   
    "extraPaths": [
        "./app"
    ],
    "executionEnvironments": [
        {
            "root": "app"
        }
    ],
    "typeCheckingMode": "strict",
    "pythonVersion": "3.13",
    "pythonPlatform": "All"
}